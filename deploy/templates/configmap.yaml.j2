---
# ConfigMap containing hpp_plan.json
# ===================================
# Mounted to all worker pods at /config/hpp_plan.json
# This ensures all workers have identical plan data
#
# Generated by: deploy/generate_manifests.py
apiVersion: v1
kind: ConfigMap
metadata:
  name: asteroid-config
  namespace: {{ namespace | default('default') }}
  labels:
    app: asteroid
    component: config
data:
  hpp_plan.json: |
{{ hpp_plan_json | indent(4, first=True) }}
