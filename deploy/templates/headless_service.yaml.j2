---
# Headless Service for PyTorch Distributed Rendezvous
# ===================================================
# Provides stable DNS for Rank 0: asteroid-master.{{ namespace }}.svc.cluster.local
# All workers use this DNS name as MASTER_ADDR for torch.distributed.init_process_group
#
# Generated by: deploy/generate_manifests.py
apiVersion: v1
kind: Service
metadata:
  name: asteroid-master
  namespace: {{ namespace | default('default') }}
  labels:
    app: asteroid
    component: master-service
spec:
  # Headless service - no cluster IP, direct pod DNS
  clusterIP: None
  selector:
    app: asteroid
    rank: "0"
  ports:
    - name: torch-dist
      port: {{ master_port | default(29500) }}
      targetPort: {{ master_port | default(29500) }}
      protocol: TCP
